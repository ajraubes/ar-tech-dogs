# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/artechdogs

# Used to encrypt JWT tokens. Use a long random string in production.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public site URL. No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Outgoing email (Afrihost SMTP). Leave SMTP_HOST empty to only log emails.
SMTP_HOST=mail.artechdogs.co.za
SMTP_PORT=465
SMTP_USER=aj@artechdogs.co.za
SMTP_PASS=
EMAIL_FROM=aj@artechdogs.co.za
EMAIL_FROM_NAME=AR Tech Dogs
